// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"

  // Runtime queries go through Supabase's transaction pooler (port 6543).
  // The pooler shares a small number of real Postgres connections across many
  // app requests, so we do not exhaust the database connection limit.
  url = env("DATABASE_URL")

  // Migrations bypass the transaction pooler and use the session pooler
  // (port 5432). Migrations need advisory locks and a stable session across
  // multiple DDL statements, which transaction-mode pooling cannot provide.
  directUrl = env("DIRECT_URL")
}
