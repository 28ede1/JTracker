generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
//
// An enum is a fixed vocabulary of allowed values that is enforced by the db.
// ---------------------------------------------------------------------------

enum OpportunityType {
  INTERNSHIP
  JOB
  HACKATHON
  VIRTUAL_EVENT
  IN_PERSON_EVENT
  RESEARCH
  FELLOWSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum FileType {
  PDF
  DOCX
}

// Tracks background resume text extraction.
enum ParseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Shared by every AI-generated record. 
enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ContactRelationship {
  RECRUITER
  HIRING_MANAGER
  ENGINEER
  ALUMNI
  REFERRAL
  OTHER
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
  GHOSTED
}

enum AlertType {
  APPLICATION_FOLLOW_UP
  CONTACT_FOLLOW_UP
  DEADLINE_REMINDER
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum ReportType {
  COMPANY_OVERVIEW
  INTERVIEW_PREP
  RECENT_NEWS
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------


// The id has no @default because it is supplied by the authentication provider (supabase)
// rather than generated here.

model User {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  username  String   @unique

  resumes      Resume[]
  contacts     Contact[]
  applications Application[]
  alerts       Alert[]
  fitAnalyses  FitAnalysis[]
}

// ---------------------------------------------------------------------------
// Company
// ---------------------------------------------------------------------------
//
// `domain` is the identity key. It holds a normalized bare hostname such as
// "stripe.com" and is unique, so "Stripe", "Stripe Inc." and "Stripe Payments"
// collapse into one row instead of three. Names are unreliable for matching
// because spelling, punctuation and legal suffixes vary by source. 
//
// `websiteUrl` is a display value. It holds the full clickable link shown in
// the UI, such as "https://stripe.com/careers", and is never used for matching.
//
// '@@index([name])' Creates a database index on company names so queries searching for a
// company by name can find matching records faster without scanning the entire table.

model Company {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  domain     String?  @unique
  websiteUrl String?
  logoUrl    String?
  industry   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  opportunities   Opportunity[]
  contacts        Contact[]
  researchReports ResearchReport[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// Opportunity
// ---------------------------------------------------------------------------

// Fields common to every opportunity are columns. Fields that vary by type,
// such as a hackathon's team size or an event's speaker list, go in `details`
// as JSON. This avoids a wide table full of columns that are null for most rows.

model Opportunity {
  id          String          @id @default(uuid()) @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  type        OpportunityType
  title       String
  description String?         @db.Text
  sourceUrl   String
  location    String?
  workMode    WorkMode?
  postedAt    DateTime?
  deadlineAt  DateTime?
  details     Json?
  isActive    Boolean         @default(true)

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  applications    Application[]
  fitAnalyses     FitAnalysis[]
  researchReports ResearchReport[]

  @@index([companyId])
  @@index([isActive, type, postedAt])
  @@index([deadlineAt])
}

// ---------------------------------------------------------------------------
// Resume
// ---------------------------------------------------------------------------

model Resume {
  id          String      @id @default(uuid()) @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  label       String
  filePath    String
  fileType    FileType
  fileSize    Int
  parsedText  String?     @db.Text
  parseStatus ParseStatus @default(PENDING)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications Application[]
  fitAnalyses  FitAnalysis[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Contact
// ---------------------------------------------------------------------------
//  @@index([userId, nextFollowUpAt]), Drives the "who should I follow up with" view.

model Contact {
  id              String              @id @default(uuid()) @db.Uuid
  firstName       String
  lastName        String?
  title           String?
  email           String?
  phone           String?
  linkedinUrl     String?
  relationship    ContactRelationship
  notes           String?             @db.Text
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  referredApplications Application[]
  alerts               Alert[]

  @@index([userId])
  @@index([companyId])
  @@index([userId, nextFollowUpAt])
}

// ---------------------------------------------------------------------------
// Application
// ---------------------------------------------------------------------------

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  status          ApplicationStatus @default(SAVED)
  appliedAt       DateTime?
  statusChangedAt DateTime          @default(now())
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  opportunityId String      @db.Uuid
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  resumeId String? @db.Uuid
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  referralContactId String?  @db.Uuid
  referralContact   Contact? @relation(fields: [referralContactId], references: [id], onDelete: SetNull)

  alerts Alert[]

  @@index([userId])
  @@index([opportunityId])
  @@index([resumeId])
  @@index([referralContactId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// FitAnalysis
// ---------------------------------------------------------------------------

// `model` and `generatedAt` record which AI model produced this and when.
// Without them, old analyses become impossible to interpret after the prompt
// or model changes.

model FitAnalysis {
  id          String           @id @default(uuid()) @db.Uuid
  status      GenerationStatus @default(PENDING)
  score       Int?
  summary     String?          @db.Text
  strengths   String[]
  gaps        String[]
  model       String?
  generatedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId String @db.Uuid
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  opportunityId String      @db.Uuid
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@index([opportunityId])
}

// ---------------------------------------------------------------------------
// ResearchReport
// ---------------------------------------------------------------------------

// Not user-owned. Research is about a company, so one report serves every user
// looking at that company. `expiresAt` marks when the content is stale enough
// to regenerate, so we are not paying for the same report repeatedly.

model ResearchReport {
  id          String           @id @default(uuid()) @db.Uuid
  reportType  ReportType
  status      GenerationStatus @default(PENDING)
  contentMd   String?          @db.Text
  sources     Json?
  model       String?
  generatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  opportunityId String?      @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([opportunityId])
}

// ---------------------------------------------------------------------------
// Alert
// ---------------------------------------------------------------------------

// An alert points at either an application or a contact, so both foreign keys
// are optional. `dedupeKey` is unique, which is what stops a retried or
// double-run background job from sending the same reminder twice. The database
// rejects the duplicate insert rather than relying on the job to check first.
model Alert {
  id           String      @id @default(uuid()) @db.Uuid
  type         AlertType
  title        String
  body         String?     @db.Text
  scheduledFor DateTime
  status       AlertStatus @default(PENDING)
  sentAt       DateTime?
  dedupeKey    String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId String?      @db.Uuid
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  contactId String?  @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([contactId])
  @@index([status, scheduledFor])
}
