# Template for backend/.env. Safe to commit: contains no real secrets.
# Copy to .env and fill in the placeholders.
#   cp .env.example .env

# Application queries: Supabase transaction-mode pooler (port 6543).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations: Supabase session-mode pooler (port 5432).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
