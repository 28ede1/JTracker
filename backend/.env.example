# ---------------------------------------------------------------------------
# Template for backend environment variables.
#
# Copy these keys into backend/.env and fill in the real values.
# This file is committed to git. .env is not, so no real value belongs here.
# ---------------------------------------------------------------------------

# Supabase Postgres connection strings.
# Supabase dashboard > Project Settings > Database > Connection string
#
# Application queries: shared transaction-mode pooler (IPv4).
DATABASE_URL=

# Migrations only: shared session-mode pooler (IPv4).
DIRECT_URL=

# ---------------------------------------------------------------------------
# Auth
#
# Used by src/lib/supabase.ts to turn an access token into a user id.
# Supabase dashboard > Project Settings > API.
#
# The same two public values the frontend uses. Verifying a token needs no
# privilege, so the secret key stays out of this file. It is only needed later
# for admin actions such as deleting a user account.
# ---------------------------------------------------------------------------

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ---------------------------------------------------------------------------
# Tests only
#
# The confirmed test account used by the live test in
# src/middleware/require-auth.test.ts, which signs in to get a real token and
# checks that a protected route accepts it.
#
# Leave either one unset and that single test skips. The 401 tests always run,
# because refusing a bad token needs no account.
# ---------------------------------------------------------------------------

TEST_USER_EMAIL=
TEST_USER_PASSWORD=
