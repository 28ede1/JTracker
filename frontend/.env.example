# ---------------------------------------------------------------------------
# Template for frontend environment variables.
#
# Copy this file to .env.local and replace the values with real ones.
# This file is committed to git. .env.local is not.
#
# The two Supabase values come from the Supabase dashboard, under Project
# Settings > API.
#
# Only public values belong here. Vite embeds every VITE_ variable directly
# into the JavaScript bundle that is sent to the browser, so anyone can read
# them. The secret key and DATABASE_URL must never be added to this file.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Where JTracker's own Express backend is listening. Locally that is the port
# backend/src/server.ts opens; once the API is deployed this becomes its public
# https address, and no code has to change for that to work.
#
# Public by nature, since it is just an address the browser has to know anyway.
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Tests only
#
# An inbox you control, used by the live sign-up tests in
# src/features/auth/signup.service.test.ts. Supabase refuses placeholder
# domains such as example.com, so a real sign-up needs a genuine address.
#
# Deliberately has no VITE_ prefix, which is what keeps it out of the browser
# bundle. Only vitest.config.ts reads it, and only tests receive it.
#
# Leave it unset and the live tests skip instead of failing. Every account they
# create is a real one that has to be deleted by hand from the dashboard, under
# Authentication > Users.
# ---------------------------------------------------------------------------

SIGNUP_TEST_EMAIL=you@yourdomain.com

# The password of the confirmed test account, used by the live log-in tests in
# src/features/auth/login.service.test.ts. That is the account you created by
# hand at the +jtracker-test-registered address.
#
# It lives here rather than in the test file because it is a real working
# credential. Use a throwaway password that guards nothing else.
#
# Leave it unset and the live log-in tests skip.
LOGIN_TEST_PASSWORD=
