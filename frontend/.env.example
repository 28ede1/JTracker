# ---------------------------------------------------------------------------
# Template for frontend environment variables.
#
# Copy this file to .env.local and replace the values with real ones.
# This file is committed to git. .env.local is not.
#
# Both values come from the Supabase dashboard, under Project Settings > API.
#
# Only public values belong here. Vite embeds every VITE_ variable directly
# into the JavaScript bundle that is sent to the browser, so anyone can read
# them. The secret key and DATABASE_URL must never be added to this file.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
